rules_version = '2';

// LifeTracker security rules.
//
// Data model (all user data is nested under the user's own document):
//   users/{uid}                      profile   { email, displayName, createdAt }
//   users/{uid}/tasks/{taskId}       task      (see validTask)
//   users/{uid}/summaries/{date}     daily report snapshot, id = "YYYY-MM-DD"
//   users/{uid}/meta/settings        user preferences (incl. assistant options)
//   users/{uid}/meta/push            Web Push key pair used by the user's desktops
//   users/{uid}/meta/presence        what the desktop is doing now (shown on the phone)
//   users/{uid}/devices/{deviceId}   phones subscribed to push notifications
//   users/{uid}/reminders/{id}       assistant reminders           { text, at, done, ... }
//   users/{uid}/memories/{id}        facts the assistant remembers { text, ... }
//   users/{uid}/chat/{id}            the assistant conversation shared by all devices
//
// Every document is readable/writable only by its owner. Writes carry an
// `updatedAt` timestamp and the rules enforce last-write-wins: an update may
// never replace a newer version of a document with an older one.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function data() {
      return request.resource.data;
    }

    function isTimestamp(v) {
      return v is int && v >= 0;
    }

    function optTimestamp(v) {
      return v == null || isTimestamp(v);
    }

    // Last-write-wins guard for updates.
    function notOlder() {
      return resource == null || data().updatedAt >= resource.data.updatedAt;
    }

    function validTask(taskId) {
      let d = data();
      return d.keys().hasAll(['id', 'title', 'estimatedHours', 'completed', 'date', 'sessions', 'createdAt', 'updatedAt', 'deleted'])
        && d.keys().hasOnly(['id', 'title', 'estimatedHours', 'completed', 'completedAt', 'date', 'sessions', 'baseMs',
                             'runningSince', 'createdAt', 'updatedAt', 'deleted', 'deviceId', 'carriedFrom'])
        && d.id == taskId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.estimatedHours is number && d.estimatedHours >= 0 && d.estimatedHours <= 24
        && d.completed is bool
        && d.deleted is bool
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.sessions is list && d.sessions.size() <= 250
        && (!('baseMs' in d) || (d.baseMs is number && d.baseMs >= 0))
        && (!('completedAt' in d) || optTimestamp(d.completedAt))
        && (!('runningSince' in d) || optTimestamp(d.runningSince))
        && isTimestamp(d.createdAt)
        && isTimestamp(d.updatedAt);
    }

    function validSummary(day) {
      let d = data();
      return d.keys().hasOnly(['date', 'totalTasks', 'completedTasks', 'hoursWorked', 'estimatedHours',
                               'productivityScore', 'efficiency', 'goalHours', 'goalReached', 'updatedAt'])
        && d.date == day
        && d.totalTasks is int && d.completedTasks is int
        && d.hoursWorked is number && d.hoursWorked >= 0 && d.hoursWorked <= 24
        && isTimestamp(d.updatedAt);
    }

    function optBool(d, k) {
      return !(k in d) || d[k] is bool;
    }

    function optInt(d, k, lo, hi) {
      return !(k in d) || (d[k] is int && d[k] >= lo && d[k] <= hi);
    }

    function validSettings() {
      let d = data();
      return d.keys().hasOnly(['displayName', 'dailyGoalHours', 'summaryHour', 'carryOver', 'autoStartNext',
                               'systemNotifications', 'assistantName', 'workStartHour', 'workEndHour',
                               'checkinMinutes', 'nudgeUntrackedMinutes', 'idlePauseMinutes', 'distractions',
                               'voice', 'sounds', 'pushToPhone', 'shareTitles', 'runInBackground', 'startAtLogin',
                               'city', 'updatedAt'])
        && (!('city' in d) || (d.city is string && d.city.size() <= 80))
        && (!('assistantName' in d) || (d.assistantName is string && d.assistantName.size() <= 30))
        && (!('distractions' in d) || (d.distractions is string && d.distractions.size() <= 1000))
        && optInt(d, 'workStartHour', 0, 23) && optInt(d, 'workEndHour', 1, 24)
        && optInt(d, 'checkinMinutes', 0, 600) && optInt(d, 'nudgeUntrackedMinutes', 0, 600)
        && optInt(d, 'idlePauseMinutes', 0, 600)
        && optBool(d, 'voice') && optBool(d, 'sounds') && optBool(d, 'pushToPhone') && optBool(d, 'shareTitles')
        && optBool(d, 'runInBackground') && optBool(d, 'startAtLogin') && optBool(d, 'carryOver')
        && optBool(d, 'autoStartNext') && optBool(d, 'systemNotifications')
        && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 60))
        && (!('dailyGoalHours' in d) || (d.dailyGoalHours is number && d.dailyGoalHours > 0 && d.dailyGoalHours <= 24))
        && (!('summaryHour' in d) || (d.summaryHour is int && d.summaryHour >= 0 && d.summaryHour <= 23))
        && isTimestamp(d.updatedAt);
    }

    function validPushKeys() {
      let d = data();
      return d.keys().hasOnly(['publicKey', 'privateKey', 'subject', 'updatedAt'])
        && d.publicKey is string && d.publicKey.size() < 200
        && d.privateKey is string && d.privateKey.size() < 200
        && isTimestamp(d.updatedAt);
    }

    function validPresence() {
      let d = data();
      return d.keys().hasOnly(['app', 'title', 'idle', 'idleSec', 'taskId', 'taskTitle', 'platform', 'supported', 'answers', 'brain', 'updatedAt'])
        && (!('brain' in d) || (d.brain is string && d.brain.size() <= 80))
        && (!('app' in d) || d.app == null || (d.app is string && d.app.size() <= 100))
        && (!('title' in d) || d.title == null || (d.title is string && d.title.size() <= 200))
        && isTimestamp(d.updatedAt);
    }

    function validDevice(deviceId) {
      let d = data();
      return d.keys().hasOnly(['id', 'endpoint', 'keys', 'platform', 'userAgent', 'deleted', 'createdAt', 'updatedAt'])
        && d.id == deviceId
        && d.endpoint is string && d.endpoint.size() < 1024 && d.endpoint.matches('^https://.*')
        && d.keys is map && d.keys.keys().hasOnly(['p256dh', 'auth'])
        && d.deleted is bool
        && isTimestamp(d.updatedAt);
    }

    function validReminder(id) {
      let d = data();
      return d.keys().hasOnly(['id', 'text', 'at', 'done', 'firedAt', 'deleted', 'createdAt', 'updatedAt'])
        && d.id == id
        && d.text is string && d.text.size() > 0 && d.text.size() <= 200
        && isTimestamp(d.at) && d.done is bool && d.deleted is bool
        && (!('firedAt' in d) || optTimestamp(d.firedAt))
        && isTimestamp(d.createdAt) && isTimestamp(d.updatedAt);
    }

    function validMemory(id) {
      let d = data();
      return d.keys().hasOnly(['id', 'text', 'deleted', 'createdAt', 'updatedAt'])
        && d.id == id
        && d.text is string && d.text.size() > 0 && d.text.size() <= 300
        && d.deleted is bool
        && isTimestamp(d.createdAt) && isTimestamp(d.updatedAt);
    }

    function validChat(id) {
      let d = data();
      return d.keys().hasOnly(['id', 'role', 'text', 'from', 'status', 'replyTo', 'actions', 'deleted', 'createdAt', 'updatedAt'])
        && d.id == id
        && d.role in ['user', 'assistant']
        && d.text is string && d.text.size() <= 4000
        && d.from in ['desktop', 'phone']
        && d.status in ['pending', 'working', 'done', 'error']
        && (!('replyTo' in d) || (d.replyTo is string && d.replyTo.size() <= 40))
        && (!('actions' in d) || (d.actions is list && d.actions.size() <= 8))
        && d.deleted is bool
        && isTimestamp(d.createdAt) && isTimestamp(d.updatedAt);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && data().keys().hasOnly(['email', 'displayName', 'createdAt']);

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTask(taskId) && notOlder();
      }

      match /summaries/{day} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSummary(day) && notOlder();
      }

      match /meta/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && notOlder() && (
          (docId == 'settings' && validSettings()) ||
          (docId == 'push' && validPushKeys()) ||
          (docId == 'presence' && validPresence())
        );
      }

      match /devices/{deviceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDevice(deviceId) && notOlder();
      }

      match /reminders/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validReminder(id) && notOlder();
      }

      match /memories/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validMemory(id) && notOlder();
      }

      match /chat/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validChat(id) && notOlder();
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
