# Copy to .env.local and fill in the same Firebase web config used by the desktop app.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional: link to your desktop downloads (e.g. GitHub Releases page)
REACT_APP_DESKTOP_DOWNLOAD_URL=https://github.com/amarnathgaddam75/Productivity_Tracker-/releases/latest

# Optional: set to 127.0.0.1 to use the local Firebase emulators (npm run emulators)
REACT_APP_FIREBASE_EMULATOR_HOST=
